# Package 0.6c, first step: a throwaway build (not the template's) that only asks the registry two questions through
# HTTPS_PROXY, to show the image build's path in option (a-prime): docker build --network host -> 127.0.0.1:13129
# (the machine-side egress proxy's loopback listener, registry only) -> the session proxy. No certificate is given.
FROM node:22-alpine@sha256:0e1754758c2df4cfa3e68d59e2e1b7374bb7fd9ea6328eaaacf15cc934af8202
ARG HTTPS_PROXY
RUN npm ping && echo "next@$(npm view next@16.4.6 version)"
RUN node -e 'fetch("https://example.com/").then(r=>console.log("M06C example.com answered",r.status)).catch(e=>console.log("M06C example.com, direct fetch (Node ignores HTTPS_PROXY):",e.cause?.code??e.message))'
RUN npm view left-pad@1.3.0 version --registry https://example.com/ 2>&1 | tail -2 || true
